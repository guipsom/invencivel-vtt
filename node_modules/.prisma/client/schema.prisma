datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GM
  PLAYER
}

enum CharacterStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum EvolutionStatus {
  PENDING
  APPROVED
  REJECTED
  ADJUSTMENT_REQUESTED
}

enum EnhancementType {
  MELHORIA
  LIMITE
}

enum EntryType {
  TALENTO
  DESVANTAGEM
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(PLAYER)
  createdAt    DateTime    @default(now())
  campaigns    Campaign[]  @relation("GMCampaigns")
  characters   Character[]
}

model Campaign {
  id         String      @id @default(uuid())
  title      String
  category   String
  gmId       String
  gm         User        @relation("GMCampaigns", fields: [gmId], references: [id])
  characters Character[]
  createdAt  DateTime    @default(now())
}

model CatalogPower {
  id           String                    @id @default(uuid())
  name         String
  powerType    String
  description  String?
  baseDamage   Int                       @default(0)
  baseRange    String?
  isOfficial   Boolean                   @default(true)
  isActive     Boolean                   @default(true)
  enhancements CatalogPowerEnhancement[]
}

model CatalogPowerEnhancement {
  id              String          @id @default(uuid())
  powerId         String
  power           CatalogPower    @relation(fields: [powerId], references: [id])
  name            String
  enhancementType EnhancementType
  description     String?
  karmaCost       Int             @default(20)
  isOfficial      Boolean         @default(true)
}

model CatalogTalentDrawback {
  id               String    @id @default(uuid())
  name             String
  entryType        EntryType
  description      String
  mechanicalEffect String?
  karmaCost        Int       @default(10)
  isOfficial       Boolean   @default(true)
  isActive         Boolean   @default(true)
}

model Character {
  id                   String             @id @default(uuid())
  playerId             String
  player               User               @relation(fields: [playerId], references: [id])
  campaignId           String
  campaign             Campaign           @relation(fields: [campaignId], references: [id])
  heroName             String
  civilName            String?
  role                 String?
  category             String
  fight                Int                @default(1)
  agility              Int                @default(1)
  strength             Int                @default(1)
  intellect            Int                @default(1)
  intuition            Int                @default(1)
  presence             Int                @default(1)
  lifeCurrent          Int
  lifeMax              Int
  determinationCurrent Int
  determinationMax     Int
  karmaTotal           Int                @default(0)
  karmaReserved        Int                @default(0)
  karmaSpent           Int                @default(0)
  reputation           Int                @default(0)
  status               CharacterStatus    @default(DRAFT)
  evolutionRequests    EvolutionRequest[]
  createdAt            DateTime           @default(now())
}

model EvolutionRequest {
  id             String          @id @default(uuid())
  characterId    String
  character      Character       @relation(fields: [characterId], references: [id])
  evolutionType  String
  targetOptionId String?
  cost           Int
  explanation    String
  status         EvolutionStatus @default(PENDING)
  gmFeedback     String?
  createdAt      DateTime        @default(now())
  processedAt    DateTime?
}
